# ── Neo4j ─────────────────────────────────────────────────────────────────────
# For Docker Compose (bundled Neo4j): neo4j://neo4j:7687
# For Neo4j Aura (cloud):             neo4j+s://xxxx.databases.neo4j.io
NEO4J__URI=neo4j://neo4j:7687
NEO4J__USER=neo4j
NEO4J__PASSWORD=password123
NEO4J__DATABASE=neo4j

# ── Embeddings ────────────────────────────────────────────────────────────────
# sentence_transformers = local (no API key needed, model downloaded on first run)
# openai                = any OpenAI-compatible embeddings endpoint
EMBEDDING__PROVIDER=sentence_transformers
EMBEDDING__MODEL=BAAI/bge-small-en-v1.5
EMBEDDING__API_KEY=
EMBEDDING__BATCH_SIZE=32

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Optional — suppresses rate-limit warnings on first model download.
# Get a free read-only token at https://huggingface.co/settings/tokens
# Not needed once the model is cached in the hf-cache Docker volume.
HF_TOKEN=

# ── Summary / LLM ─────────────────────────────────────────────────────────────
# Provider: ollama (local) or openai (any OpenAI-compatible endpoint)
SUMMARY__PROVIDER=ollama

# Base URL of the LLM server.
# Docker Compose default (bundled ollama service): http://ollama:11434
#   — the compose file sets this automatically; no need to change it here.
# Host Ollama (macOS/Windows): http://host.docker.internal:11434
# Host Ollama (Linux):         http://172.17.0.1:11434
# Local Python (no Docker):    http://localhost:11434
# LM Studio:                   http://localhost:1234
# llama.cpp server:            http://localhost:8080
# OpenAI cloud:                https://api.openai.com
SUMMARY__BASE_URL=http://localhost:11434

SUMMARY__MODEL=qwen2.5-coder:7b
SUMMARY__API_KEY=
SUMMARY__TEMPERATURE=0.1

# Parallel LLM calls during enrichment.
# CPU inference (Ollama, llama.cpp, LM Studio on CPU): 1
# GPU inference:                                       4–8
# Cloud APIs (OpenAI, Groq, etc.):                     8–16
SUMMARY__MAX_CONCURRENT=1

# ── MCP server ────────────────────────────────────────────────────────────────
# stdio = Claude Code / Claude Desktop (local Python only)
# http  = Claude Code remote, Copilot, custom agents (Docker default)
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8765

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Repository mount (Docker only) ────────────────────────────────────────────
# Absolute path to the local repository you want to ingest.
# The container mounts it at /mnt/repo — pass that path to code-kg ingest.
# To mount multiple repos add extra volume entries in docker-compose.yml.
REPO_PATH=/absolute/path/to/your-repo

# ── Git workdir ───────────────────────────────────────────────────────────────
# Where remote GitHub repos are cloned during ingest.
WORKDIR=/tmp/code-kg-repos
