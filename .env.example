# Neo4j configuration
NEO4J__URI=<fill in your Neo4j URI, e.g., bolt://localhost:7687>
NEO4J__USERNAME=<fill in your Neo4j username>
NEO4J__PASSWORD=<fill in your Neo4j password>
NEO4J__DATABASE=<fill in your Neo4j database>

# Embedding provider: sentence_transformers or openai
EMBEDDING__PROVIDER=sentence_transformers
EMBEDDING__MODEL=BAAI/bge-small-en-v1.5
EMBEDDING__API_KEY=

# HuggingFace token — optional, but avoids rate-limit warnings on model downloads.
# Get one free at https://huggingface.co/settings/tokens (read-only token is enough).
# Once the model is cached in the hf-cache Docker volume, this is no longer needed.
HF_TOKEN=

# Summary provider: ollama or openai
SUMMARY__PROVIDER=ollama
SUMMARY__BASE_URL=http://localhost:11434
SUMMARY__MODEL=qwen2.5-coder:7b
SUMMARY__API_KEY=
SUMMARY__TEMPERATURE=0.1
# CPU Ollama: keep at 1 — it processes one request at a time and queued
# requests get their connections reset, causing spurious retry warnings.
# Increase to 4–8 if you have a GPU or are using the OpenAI provider.
SUMMARY__MAX_CONCURRENT=1

# MCP transport: stdio or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765

# Logging
LOG_LEVEL=INFO
